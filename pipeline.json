{
  "stage": "fast-dynamic-e2e-v2",
  "board_prefix": "xhs-run",
  "workspace": ".",
  "default_assignee": "agent-6ef809b5bf450f39",
  "target_source": "dynamic_search",
  "search_keywords": [
    "AI长任务中断怎么办",
    "Codex任务断了怎么继续",
    "不会写代码 AI助手"
  ],
  "max_parallel": 1,
  "policy": {
    "candidate_max_age_days": 30,
    "max_posts_checked": 3,
    "unknown_account_is_warning": true,
    "require_exact_target_floor": true,
    "require_no_exact_duplicate_in_target_thread": true,
    "require_no_exact_duplicate_outside_target_thread": false,
    "vision_calls": 0
  },
  "tasks": [
    {
      "key": "scout",
      "name": "1️⃣ 搜索与核验",
      "prompt": "prompts/scout-worker.md",
      "max_runtime": "8m",
      "parents": [],
      "body_vars": {
        "OUTPUT_FILE": "runtime/scout-result.json"
      }
    },
    {
      "key": "chair",
      "name": "2️⃣ 快速定稿",
      "prompt": "prompts/chair-worker.md",
      "max_runtime": "3m",
      "parents": ["scout"],
      "body_vars": {
        "INPUT_FILE": "runtime/scout-result.json",
        "OUTPUT_FILE": "runtime/chair-decision.json"
      }
    },
    {
      "key": "publish-send",
      "name": "3️⃣ 精确发布",
      "prompt": "prompts/publish-send-worker.md",
      "max_runtime": "8m",
      "parents": ["chair"],
      "body_vars": {
        "SCOUT_FILE": "runtime/scout-result.json",
        "CHAIR_FILE": "runtime/chair-decision.json",
        "OUTPUT_FILE": "runtime/publish-result.json"
      }
    },
    {
      "key": "publish-verify",
      "name": "4️⃣ 发布复核",
      "prompt": "prompts/publish-verify-worker.md",
      "max_runtime": "6m",
      "parents": ["publish-send"],
      "body_vars": {
        "SCOUT_FILE": "runtime/scout-result.json",
        "CHAIR_FILE": "runtime/chair-decision.json",
        "PUBLISH_FILE": "runtime/publish-result.json"
      }
    }
  ]
}
